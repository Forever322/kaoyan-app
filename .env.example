# Docker Compose 生产环境模板（复制为仓库根目录 .env 后填写）。
# 不要提交真实 .env，也不要在密码中使用 #、换行或未转义的 $。
NODE_ENV=production
PORT=3000

# 正式 Web / App 网关来源；多个来源使用英文逗号分隔，不能使用 *。
CORS_ORIGINS=https://kaoyan.dfnbxjj688.xyz
ALLOW_DEV_HEADER_AUTH=false
AUTH_TOKEN_TTL_DAYS=90
AUTH_REQUESTS_PER_15_MIN=30

# MySQL 8.4 LTS。服务器无法拉取 Docker Hub 时，请保持此标签与离线导入镜像一致。
MYSQL_IMAGE=mysql:8.4
# 每次后端发布使用新标签；确认稳定后再清理旧镜像，便于快速回滚。
API_IMAGE=kaoyan-api:2026.08.09-mysql.1
MYSQL_VOLUME_NAME=kaoyan-app_mysql-data
DB_DRIVER=mysql
RUN_MIGRATIONS_ON_START=false
MYSQL_DATABASE=kaoyan
MYSQL_USER=kaoyan_app
# 使用 `openssl rand -hex 32` 生成，填写后勿包含在截图、Git 或前端配置中。
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_RETRIES=12
MYSQL_CONNECT_RETRY_MS=1000
MYSQL_CONNECT_TIMEOUT_MS=10000
# api-migrate 获取 schema 锁的最大等待时间；发布时保持单一迁移流程。
MYSQL_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# 升级已有 sql.js 部署时使用原 Docker 卷名；新部署无需修改，也不要删除该旧卷。
LEGACY_SQLJS_VOLUME=kaoyan-app_kaoyan-data

# 参考数据写入默认关闭。仅受控运维脚本需要时设置高强度随机值。
DATA_ADMIN_TOKEN=

AGENT_TIMEOUT_MS=30000
AGENT_MAX_TOKENS=1200
AGENT_CONTEXT_MAX_BYTES=24000
AGENT_REQUESTS_PER_MINUTE=8
AGENT_DAILY_REQUEST_LIMIT=30
AGENT_PROPOSAL_TTL_DAYS=7

# OpenAI 兼容模型服务。真实密钥只留在服务器 .env。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-server-side-key
AGENT_MODEL=deepseek-chat
