# Docker Compose 生产环境模板（复制为仓库根目录 .env 后填写）。
# 不要提交真实 .env，也不要在密码中使用 #、换行或未转义的 $。
NODE_ENV=production
PORT=3000

# 正式 Web / App 网关来源；多个来源使用英文逗号分隔，不能使用 *。
CORS_ORIGINS=https://kaoyan.dfnbxjj688.xyz
TRUST_PROXY=true
ALLOW_DEV_HEADER_AUTH=false
AUTH_TOKEN_TTL_DAYS=90
AUTH_REQUESTS_PER_15_MIN=30
ADMIN_DATABASE_IMPORT_BODY_LIMIT=12mb
ADMIN_DATABASE_IMPORT_BODY_BYTES=12582912
ADMIN_IMPORT_REQUESTS_PER_MINUTE=12
JSON_BODY_LIMIT=1mb

# MySQL 8.4 LTS。服务器无法拉取 Docker Hub 时，请保持此标签与离线导入镜像一致。
MYSQL_IMAGE=mysql:8.4
# MySQL 需要被外部工具直连时发布到宿主机；务必在云安全组中限制来源 IP。
MYSQL_PUBLIC_BIND_ADDRESS=0.0.0.0
MYSQL_PUBLIC_PORT=3306
# 每次后端发布使用新标签；确认稳定后再清理旧镜像，便于快速回滚。
API_IMAGE=kaoyan-api:2026.08.09-mysql.1
MYSQL_VOLUME_NAME=kaoyan-app_mysql-data
DB_DRIVER=mysql
RUN_MIGRATIONS_ON_START=false
MYSQL_DATABASE=kaoyan
MYSQL_USER=kaoyan_app
# 使用 `openssl rand -hex 32` 生成，填写后勿包含在截图、Git 或前端配置中。
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_RETRIES=12
MYSQL_CONNECT_RETRY_MS=1000
MYSQL_CONNECT_TIMEOUT_MS=10000
# api-migrate 获取 schema 锁的最大等待时间；发布时保持单一迁移流程。
MYSQL_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# 升级已有 sql.js 部署时使用原 Docker 卷名；新部署无需修改，也不要删除该旧卷。
LEGACY_SQLJS_VOLUME=kaoyan-app_kaoyan-data

# 参考数据写入默认关闭。仅受控运维脚本需要时设置高强度随机值。
DATA_ADMIN_TOKEN=

AGENT_TIMEOUT_MS=30000
AGENT_MAX_TOKENS=1200
AGENT_CONTEXT_MAX_BYTES=24000
AGENT_REQUESTS_PER_MINUTE=8
AGENT_DAILY_REQUEST_LIMIT=30
AGENT_PROPOSAL_TTL_DAYS=7
ADMIN_AGENT_REQUESTS_PER_MINUTE=6
ADMIN_AGENT_MAX_ROWS=500
ADMIN_AGENT_STAGING_TTL_HOURS=24
AGENT_MODEL_TEST_REQUESTS_PER_MINUTE=3
AGENT_MODEL_SAVE_REQUESTS_PER_MINUTE=6
AGENT_MODEL_TEST_TIMEOUT_MS=10000
# 数据库管理 Agent 的公网资料核验默认关闭。开启后只调用服务端配置的搜索接口，
# webfetch 会拒绝内网/本机地址、非 HTTP(S) 协议和超限响应。
ADMIN_AGENT_WEB_RESEARCH_ENABLED=false
ADMIN_AGENT_WEB_SEARCH_ENABLED=true
ADMIN_AGENT_WEB_FETCH_ENABLED=true
# generic / bing / brave / serper。generic endpoint 可包含 {query}，否则自动追加 ?q=。
ADMIN_AGENT_WEB_SEARCH_PROVIDER=generic
ADMIN_AGENT_WEB_SEARCH_ENDPOINT=
ADMIN_AGENT_WEB_SEARCH_API_KEY=
ADMIN_AGENT_WEB_SEARCH_KEY_HEADER=Authorization
# 留空允许公网域名；填写时为英文逗号分隔的精确域名或其子域名白名单。
ADMIN_AGENT_WEB_FETCH_ALLOWED_HOSTS=
ADMIN_AGENT_WEB_TIMEOUT_MS=8000
ADMIN_AGENT_WEB_MAX_QUERIES=4
ADMIN_AGENT_WEB_MAX_RESULTS=5
ADMIN_AGENT_WEB_FETCH_MAX_PAGES=4
ADMIN_AGENT_WEB_FETCH_MAX_BYTES=262144
# DeepSeek/OpenAI 官方域名已内置；额外兼容服务只填写精确 HTTPS 主机名，逗号分隔。
AGENT_LLM_ALLOWED_HOSTS=
# `openssl rand -base64 32` 生成。此主密钥只用于加密后台保存的模型 API Key。
AGENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-64-char-hex-key
AGENT_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
ADMIN_ACCESS_LOG_RETENTION_DAYS=90
# 使用 `openssl rand -hex 32` 生成；更换后历史 IP 哈希将无法关联。
ADMIN_LOG_IP_HASH_SALT=replace-with-a-random-log-hash-salt

# OpenAI 兼容模型服务。真实密钥只留在服务器 .env。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-server-side-key
AGENT_MODEL=deepseek-chat
AGENT_TEMPERATURE=0.35
