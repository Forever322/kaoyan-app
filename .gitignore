.vercel
# Docker Compose 会从仓库根目录读取 .env；其中包含数据库和模型密钥，绝不提交。
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Dependencies
node_modules/
package-lock.json

# Build output
dist/
*.apk
# Local deployment artifacts: upload these directly to the server, never GitHub.
*.tar
*.tar.gz
*.tgz
kaoyan-web-*.zip
android-twa/.gradle/
android-twa/build/
android-twa/app/build/
# WebView 资源由 Gradle syncWebAssets 从 dist 生成，属构建产物
android-twa/app/src/main/assets/

# Android 本地配置与签名密钥（不入库；CI 用 keytool 重新生成 keystore）
android-twa/local.properties
android-twa/release.keystore
android-twa/keystore.properties
android-twa/gradle/wrapper/*.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Debug / scraping artifacts
*.json
!public/manifest.json
!public/version.json
!package.json
!pnpm-workspace.yaml
!tools/
!tools/data-maintenance/
!tools/data-maintenance/*.json
*.cjs
!tools/data-maintenance/*.cjs

# Claude Code local files
.claude/
