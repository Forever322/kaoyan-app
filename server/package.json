{
    "name": "kaoyan-server",
    "version": "1.0.0",
    "description": "考研择校助手 - 后端 API 服务",
    "type": "module",
    "scripts": {
        "dev": "node --watch src/index.js",
        "start": "node src/index.js",
        "db:migrate": "node src/db/migrate.js",
        "db:seed": "node src/db/seed.js",
        "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.0.0",
        "openai": "^7.4.0",
        "sql.js": "^1.14.1"
    }
}