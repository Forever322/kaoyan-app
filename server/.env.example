# 本地开发可设为 development；生产由 Docker Compose 传入 production。
NODE_ENV=development
PORT=3000

# 多个浏览器来源使用英文逗号分隔。生产必须填写实际 HTTPS 域名，不能使用 *。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 仅本地旧前端联调时可为 true；生产环境必须为 false。
ALLOW_DEV_HEADER_AUTH=true
AUTH_TOKEN_TTL_DAYS=90

# 单次模型调用超时（毫秒）。
AGENT_TIMEOUT_MS=30000
AGENT_MAX_TOKENS=1200
AGENT_CONTEXT_MAX_BYTES=24000
# 单进程 MVP 配额；多实例部署后应改由 Redis 统一限流与计数。
AGENT_REQUESTS_PER_MINUTE=8
AGENT_DAILY_REQUEST_LIMIT=30
AGENT_PROPOSAL_TTL_DAYS=7
AUTH_REQUESTS_PER_15_MIN=30

# OpenAI 兼容模型服务配置。仅在服务器/本地私有 .env 中填写真实密钥，绝不提交。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-server-side-key
AGENT_MODEL=deepseek-chat
