# 本地开发可设为 development；生产由 Docker Compose 传入 production。
NODE_ENV=development
PORT=3000

# 多个浏览器来源使用英文逗号分隔。生产必须填写实际 HTTPS 域名，不能使用 *。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# 仅本地旧前端联调时可为 true；生产环境必须为 false。
ALLOW_DEV_HEADER_AUTH=true
AUTH_TOKEN_TTL_DAYS=90
# JSON 请求体上限。数据库导入通过 JSON/base64 承载 xlsx 时需要比普通 API 更大。
ADMIN_DATABASE_IMPORT_BODY_LIMIT=12mb
ADMIN_DATABASE_IMPORT_BODY_BYTES=12582912
ADMIN_IMPORT_REQUESTS_PER_MINUTE=12
# 普通接口保持较小请求体；仅数据库/Agent 文件导入路由使用上面的 12MB 上限。
JSON_BODY_LIMIT=1mb

# MySQL 运行数据库。Docker Compose 会将 HOST 覆盖为 mysql；本机直接运行时改为本机地址。
# ROOT 密码仅用于初始化/备份恢复，API 连接只能使用 MYSQL_USER / MYSQL_PASSWORD。
DB_DRIVER=mysql
# 本机开发可自动迁移；Docker 生产环境由 Compose 固定为 false 并显式运行 api-migrate。
RUN_MIGRATIONS_ON_START=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kaoyan
MYSQL_USER=kaoyan_app
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_RETRIES=12
MYSQL_CONNECT_RETRY_MS=1000
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# 单次模型调用超时（毫秒）。
AGENT_TIMEOUT_MS=30000
AGENT_MAX_TOKENS=1200
AGENT_CONTEXT_MAX_BYTES=24000
# 单进程 MVP 配额；多实例部署后应改由 Redis 统一限流与计数。
AGENT_REQUESTS_PER_MINUTE=8
AGENT_DAILY_REQUEST_LIMIT=30
AGENT_PROPOSAL_TTL_DAYS=7
ADMIN_AGENT_REQUESTS_PER_MINUTE=6
ADMIN_AGENT_MAX_ROWS=500
ADMIN_AGENT_STAGING_TTL_HOURS=24
# 管理访问日志只存路径与状态，不存请求正文；IP 默认掩码，设置随机盐后改为不可逆哈希。
ADMIN_ACCESS_LOG_RETENTION_DAYS=90
ADMIN_LOG_IP_HASH_SALT=
AUTH_REQUESTS_PER_15_MIN=30

# 仅用于首次初始化后台超级管理员。先注册目标账号，然后临时设置两个值，
# 执行 admin:bootstrap 并立即从生产 .env 删除它们；绝不写入前端构建产物。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_TOKEN=

# 参考院校/国家线写入默认关闭。仅受控运维脚本需要时设置高强度随机值，
# 并在请求中传 X-Data-Admin-Token；普通前端永远不应包含此值。
DATA_ADMIN_TOKEN=

# OpenAI 兼容模型服务配置。仅在服务器/本地私有 .env 中填写真实密钥，绝不提交。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-server-side-key
AGENT_MODEL=deepseek-chat
